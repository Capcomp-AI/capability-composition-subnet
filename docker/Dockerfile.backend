# The evaluation engine.
#
# The image digest of the build is written into every published report, so a
# report identifies the exact software that produced it. That only means
# something if the build is reproducible, which is why dependencies are pinned by
# a lock file rather than resolved at build time.

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-venv \
        python3-pip \
        git \
        curl \
        ca-certificates \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

WORKDIR /app

# Dependencies first: they change far less often than the source, so this layer
# survives most rebuilds.
COPY requirements.txt pyproject.toml ./
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install -r requirements.txt

COPY capability_subnet ./capability_subnet
COPY neurons ./neurons
COPY README.md ./
RUN python3 -m pip install --no-deps -e ".[backend]"

# The engine writes state and reads the adapter pool; both are mounted, so the
# image itself stays read-only in normal operation.
VOLUME ["/app/state", "/app/pool"]

# Runs unprivileged. The engine never needs root — the one thing that executes
# untrusted input is the code runner, which lives in its own container.
RUN useradd --system --uid 10001 --create-home capsub \
    && mkdir -p /app/state /app/pool \
    && chown -R capsub:capsub /app
USER capsub

ENV CAPSUB_STATE_DIR=/app/state \
    CAPSUB_ADAPTER_POOL_DIR=/app/pool

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import capability_subnet; print(capability_subnet.__version__)" || exit 1

ENTRYPOINT ["python3", "-m", "capability_subnet.backend.service"]
