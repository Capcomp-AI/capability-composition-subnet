# The inventory and safety tool services.
#
# Both are small deterministic services with no state beyond what the
# orchestrator loads for the instance being run. They sit on the sandbox's
# internal network, reachable by the agent container and by nothing else.

FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        "fastapi>=0.110" \
        "uvicorn>=0.29" \
        "pydantic>=2.6"

# Only the modules these services need. Copying the whole package would put the
# scorer and the ground-truth generator inside a container the agent can reach.
COPY capability_subnet/__init__.py ./capability_subnet/__init__.py
COPY capability_subnet/common ./capability_subnet/common
COPY capability_subnet/sandbox/__init__.py ./capability_subnet/sandbox/__init__.py
COPY capability_subnet/sandbox/services ./capability_subnet/sandbox/services
COPY capability_subnet/workflows ./capability_subnet/workflows

ENV PYTHONPATH=/app

RUN useradd --system --uid 65534 --no-create-home tools 2>/dev/null || true
USER 65534:65534

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request,os,sys; \
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('CAPSUB_SERVICE_PORT','8091')+'/health', timeout=3).status==200 else 1)"

ENTRYPOINT ["python", "-m"]
CMD ["capability_subnet.sandbox.services.inventory_api"]
