# Environment overrides. Copy to .env; never commit the filled-in version.
#
# Anything set here overrides the same field in backend.yaml. Use it for
# per-host details and secrets; keep the durable configuration in the YAML file
# where it can be reviewed.

# --- chain -----------------------------------------------------------------
CAPSUB_NETUID=1
CAPSUB_NETWORK=finney
CAPSUB_WALLET_NAME=capability
CAPSUB_WALLET_HOTKEY=default

# --- secrets ---------------------------------------------------------------
# The root every hidden instance draw is derived from. Generate once with:
#   python3 -c "import secrets; print(secrets.randbits(63))"
# Publishing this publishes every future hidden instance.
CAPSUB_HIDDEN_SEED_ROOT=

# PostgreSQL password used by the sandbox compose file.
CAPSUB_PG_PASSWORD=

# --- engine ----------------------------------------------------------------
CAPSUB_STATE_DIR=state
CAPSUB_ADAPTER_POOL_DIR=./pool
CAPSUB_POSTGRES_DSN=
# Blank is refused at start-up exactly as `unpinned` is: a report whose digest
# identifies nothing does not identify the software that produced it. Fill it in:
#   docker inspect --format='{{index .RepoDigests 0}}' capability-subnet/engine:latest
CAPSUB_EVALUATOR_IMAGE_DIGEST=
CAPSUB_LOG_LEVEL=INFO

# --- serving ---------------------------------------------------------------
# 'managed' starts a vLLM process per candidate with that candidate's adapter
# applied. 'external' cannot apply an adapter and the engine refuses to run in
# it — every candidate would be scored against the same static endpoint.
CAPSUB_SERVING_MODE=managed
# Local copy of the pinned base model. Evaluation runs offline, so it must
# already be on disk.
CAPSUB_BASE_MODEL_PATH=
# Address the card by UUID. An index is not stable: when a card fails, CUDA
# renumbers around it and NVML does not, so the same integer names two
# different GPUs and the engine serves on one while measuring the other.
CAPSUB_SERVING_GPU_UUID=
CAPSUB_SERVING_GPU_INDEX=0
# gpu_memory_utilization is a fraction of the WHOLE card, not of what is free,
# so a card with other tenants needs that fraction actually free. It pairs with
# the context length: too low leaves nothing for cache blocks and vLLM refuses
# to start, too long a context wants more cache than the fraction allows and it
# refuses again. Change one at a time.
CAPSUB_SERVING_MAX_MODEL_LEN=4096
CAPSUB_SERVING_GPU_MEMORY_UTILIZATION=0.78
# The interpreter vLLM runs under. Set it when vLLM has its own virtualenv,
# which is common because it pins torch tightly.
CAPSUB_SERVING_PYTHON=
CAPSUB_SERVING_BASE_URL=http://127.0.0.1:8000

# --- reconstruction --------------------------------------------------------
# cuda is ~30x faster on the trimming methods. Consensus-relevant: cuSOLVER and
# LAPACK do not agree bit-for-bit, so every worker in one deployment must use
# the same device, and the report records which.
CAPSUB_MERGE_DEVICE=cuda
CAPSUB_MERGE_GPU_INDEX=0

# Bind address for the read-only API. Leave on loopback unless a reverse proxy
# terminates TLS in front of it.
CAPSUB_API_HOST=127.0.0.1

# --- validator -------------------------------------------------------------
# The engine API a validator polls.
CAPSUB_BACKEND_URL=http://127.0.0.1:8080
# Comma-separated operator hotkeys whose signatures this validator accepts.
# Leaving it empty is a startup error: the validator refuses to run rather than
# silently trusting whatever answers at the configured URL.
CAPSUB_TRUSTED_SIGNERS=

# Deliberately accept unsigned vectors. Only for local development — this is the
# explicit opt-out for the check above, and it exists so that turning it off is
# always a decision somebody made rather than a default they inherited.
CAPSUB_ALLOW_UNSIGNED=

# --- miner -----------------------------------------------------------------
CAPSUB_RECIPE=recipe.json
CAPSUB_RECIPE_URI=
