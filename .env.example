# Environment overrides. Copy to .env; never commit the filled-in version.
#
# Anything set here overrides the same field in backend.yaml. Use it for
# per-host details and secrets; keep the durable configuration in the YAML file
# where it can be reviewed.

# --- chain -----------------------------------------------------------------
CAPSUB_NETUID=1
CAPSUB_NETWORK=finney
CAPSUB_WALLET_NAME=capability
CAPSUB_WALLET_HOTKEY=default

# --- secrets ---------------------------------------------------------------
# The root every hidden instance draw is derived from. Generate once with:
#   python3 -c "import secrets; print(secrets.randbits(63))"
# Publishing this publishes every future hidden instance.
CAPSUB_HIDDEN_SEED_ROOT=

# PostgreSQL password used by the sandbox compose file.
CAPSUB_PG_PASSWORD=

# --- engine ----------------------------------------------------------------
CAPSUB_STATE_DIR=state
CAPSUB_ADAPTER_POOL=./pool
CAPSUB_SERVING_BASE_URL=http://127.0.0.1:8000
CAPSUB_POSTGRES_DSN=
CAPSUB_EVALUATOR_IMAGE_DIGEST=
CAPSUB_LOG_LEVEL=INFO

# Bind address for the read-only API. Leave on loopback unless a reverse proxy
# terminates TLS in front of it.
CAPSUB_API_BIND=127.0.0.1

# --- validator -------------------------------------------------------------
# The engine API a validator polls.
CAPSUB_BACKEND_URL=http://127.0.0.1:8080
# Comma-separated operator hotkeys whose signatures this validator accepts.
# Leaving it empty is a startup error: the validator refuses to run rather than
# silently trusting whatever answers at the configured URL.
CAPSUB_TRUSTED_SIGNERS=

# Deliberately accept unsigned vectors. Only for local development — this is the
# explicit opt-out for the check above, and it exists so that turning it off is
# always a decision somebody made rather than a default they inherited.
CAPSUB_ALLOW_UNSIGNED=

# --- miner -----------------------------------------------------------------
CAPSUB_RECIPE=recipe.json
CAPSUB_RECIPE_URI=
